{
  "name": "zapret-control-center",
  "version": "0.3.0-beta.13",
  "private": true,
  "author": "Zapret Team",
  "description": "Electron control center for Flowseal zapret-discord-youtube.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:admin": "electron . --admin",
    "test": "node --test",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zapret-control-center",
    "productName": "Zapret Control Center",
    "publish": [
      {
        "provider": "github",
        "owner": "thetunix",
        "repo": "Zapret-Control",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "app-version.txt",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Zapret-Control-Center-Setup-${version}.${ext}",
    "extraFiles": [
      {
        "from": "zapret",
        "to": "zapret",
        "filter": [
          "**/*",
          "!.zapret-backups/**"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "zapret/lists",
        "to": "zapret-seed/lists",
        "filter": ["**/*", "!**/*.backup"]
      }
    ]
  }
}
